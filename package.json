{
  "name": "asterlyn",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "icons:generate": "node scripts/generate-desktop-icons.mjs",
    "protocol:generate": "node scripts/generate-desktop-protocol.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:conflict:rendered": "node scripts/test-conflict-editor-rendered.mjs",
    "test:diff:rendered": "node scripts/test-diff-editor-rendered.mjs",
    "test:editor-patch:rendered": "node scripts/test-editor-patch-popover-rendered.mjs",
    "test:native:rendered": "node scripts/smoke-native-app.mjs --require-rendered target/release/asterlyn",
    "test:native:rendered:build": "tauri build --no-bundle && npm run test:native:rendered",
    "tauri": "tauri"
  },
  "dependencies": {
    "@asterlyn/plugin-android-gradle": "file:vendor/plugins/asterlyn-plugin-android-gradle-0.5.2.tgz",
    "@asterlyn/plugin-sdk": "file:packages/plugin-sdk",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "markdown-it": "^15.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "22.20.2",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
